# Copy to .env and fill in. Used by scripts/push-pi.sh, scripts/deploy-pi.sh,
# and scripts/pi-logs.sh. The file is gitignored.

# Required: SSH connection to the test Pi.
SSH_USER=pi
SSH_IP=10.0.0.42

# Optional: SSH password (uses sshpass). Omit when using SSH keys.
# The scripts pass this to sshpass via the SSHPASS environment variable
# (`sshpass -e`), never on the command line, so it does not leak into the
# process list (/proc/*/cmdline) the way `sshpass -p` does.
# SSH_PASSWORD=

# Optional: sudo password on the Pi (defaults to SSH_PASSWORD). Fed to
# `sudo -S` over the SSH session's stdin, not via argv.
# SUDO_PASSWORD=

# Optional: trust-on-first-use warning. With StrictHostKeyChecking=accept-new,
# the FIRST connection blindly accepts whatever host key the Pi presents; that
# protects you from later key changes but NOT from a MITM on first contact.
# To pin the key ahead of time, put the Pi's entry in a known_hosts file and
# point this at it (the scripts then use StrictHostKeyChecking=yes):
#   ssh-keyscan -H 10.0.0.42 >> ~/.ssh/capi_pi_known_hosts
# CAPI_KNOWN_HOSTS=~/.ssh/capi_pi_known_hosts

# Optional: which binary variant to build/push for this Pi.
#   PI_ARCH:   arm64 (default) | armv6
#   PI_LIBCEC: 6 (Bookworm/older Pi OS) | 7 (Trixie/newer)
# Leave PI_LIBCEC unset to auto-detect the Pi's installed libcec ABI.
# PI_ARCH=arm64
# PI_LIBCEC=6

# Optional: Pi paths (defaults shown).
# PI_INSTALL_DIR=/opt/capi
# PI_SERVICE=capi.service

# Optional: bearer token for testing an auth-enabled capi instance from
# test.sh (401 without the key / 200 with it are asserted when set).
# CAPI_TOKEN=
