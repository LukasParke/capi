{{define "bus_banner"}}
<div class="bus-banner">
  {{if .CECReady}}
  <strong>Bus:</strong>
  {{if .ScanInProgress}}scan in progress{{else}}idle{{end}}
  · <strong>Stale:</strong> {{if .Stale}}yes{{else}}no{{end}}
  {{if .LastFullScan}}· <strong>Last scan:</strong> {{.LastFullScan}}{{end}}
  · <strong>Monitoring:</strong> {{if .Monitoring}}on{{else}}off{{end}}
  · <strong>Active source LA:</strong> {{.ActiveSource}}
  · <strong>Devices in cache:</strong> {{.DeviceCount}}
  {{else}}
  <strong>CEC adapter:</strong> not ready
  {{end}}
</div>
{{end}}
