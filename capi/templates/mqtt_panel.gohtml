{{define "mqtt_panel"}}
<h2>MQTT bridge</h2>
<p style="font-size:.72rem;color:var(--muted);margin-bottom:8px">
  Connection: {{if .Connected}}<span class="badge">connected</span>{{else}}<span class="badge off">disconnected</span>{{end}}
</p>
<form hx-post="/ui/action/mqtt_save" hx-target="#action-flash" hx-swap="innerHTML" style="display:grid;gap:8px;max-width:520px">
  <label>Broker URL<br><input type="text" name="broker" value="{{.Broker}}" placeholder="tcp://host:1883" style="width:100%"></label>
  <label>Username<br><input type="text" name="user" value="{{.User}}" style="width:100%"></label>
  <label>Password<br><input type="password" name="pass" placeholder="leave blank to keep current" autocomplete="new-password" style="width:100%"></label>
  <label><input type="checkbox" name="clear_password" value="1"> Clear stored password</label>
  <label>Topic prefix<br><input type="text" name="prefix" value="{{.Prefix}}" style="width:100%"></label>
  <button type="submit">Save MQTT settings</button>
</form>
<p style="font-size:.7rem;color:var(--muted);margin-top:8px">JSON API <code>GET/POST /api/settings/mqtt</code> unchanged. Empty password keeps the saved secret unless you check clear.</p>
{{end}}
