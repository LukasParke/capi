{{define "settings_layout"}}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>capi settings</title>
  <link rel="stylesheet" href="/ui/static/style.css">
  <script src="/ui/static/htmx.min.js"></script>
</head>
<body class="remote">
  <header class="remote-head">
    <div>
      <h1>capi settings</h1>
      <span class="muted">v {{.Version}}</span>
    </div>
    <nav class="remote-nav">
      <a href="/">Remote</a>
      <a href="/dev">Dev</a>
    </nav>
  </header>

  <section class="card">
    <h2>MQTT bridge</h2>
    <div id="mqtt-card"
         hx-get="/ui/fragment/mqtt_panel"
         hx-trigger="load"
         hx-swap="innerHTML"></div>
  </section>

  <section class="card">
    <h2>CEC adapter</h2>
    <p class="muted" style="font-size:.75rem">
      The adapter runs in <strong>passive</strong> mode by default: it never claims
      active source, never wakes the TV on connect, and never broadcasts standby
      on disconnect. Toggle modes from the <a href="/dev">Dev</a> page.
    </p>
    <p class="muted" style="font-size:.75rem">
      Service: <code>{{.Version}}</code>. Restart with <code>sudo systemctl restart capi</code>.
    </p>
  </section>

  <section class="card">
    <h2>Update</h2>
    <p class="muted" style="font-size:.75rem">
      Currently running <code>{{.Version}}</code>. Click below to check for and install the latest GitHub release.
    </p>
    <button type="button" class="big"
            hx-post="/api/update"
            hx-target="#action-flash" hx-swap="innerHTML">Check for update</button>
  </section>

  <div id="action-flash" class="result" style="margin-top:12px"></div>
</body>
</html>
{{end}}
