{{define "topology_hdmi"}}
<h2>Source / HDMI</h2>
{{if .Ready}}
<div style="margin-bottom:10px">
  <label>Set active source (logical address)</label>
  <form class="btn-row" style="margin-top:4px" hx-post="/ui/action/set_source" hx-target="#action-flash" hx-swap="innerHTML">
    <select name="addr">
      {{range .SelectAddrs}}
      <option value="{{.}}">{{.}}</option>
      {{end}}
    </select>
    <button type="submit">Activate</button>
  </form>
</div>
<div>
  <label>Switch display HDMI port</label>
  <div class="btn-row" style="margin-top:4px">
    {{range .PortNums}}
    <button type="button" hx-post="/ui/action/hdmi?port={{.}}" hx-target="#action-flash" hx-swap="innerHTML">HDMI {{.}}</button>
    {{end}}
  </div>
</div>
{{else}}
<p style="color:var(--muted)">CEC not available.</p>
{{end}}
{{end}}
