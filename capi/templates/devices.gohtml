{{define "devices"}}
{{if .Message}}<p class="muted" style="font-size:.75rem;margin-bottom:6px">{{.Message}}</p>{{end}}
{{if .Devices}}
<div class="device-grid">
  {{range .Devices}}
  <div class="dev-card{{if .IsActiveSource}} active-src{{end}}{{if .IsGhost}} ghost{{end}}">
    <div class="dev-name">
      {{.DisplayName}}
      {{if .IsOwn}}<span class="badge off" style="font-size:.6rem">us</span>{{end}}
      {{if .IsActiveSource}}<span class="badge ok" style="font-size:.6rem">active</span>{{end}}
      {{if .IsGhost}}<span class="badge warn" style="font-size:.6rem">observed</span>{{end}}
    </div>
    <div class="dev-meta">
      {{if .Role}}{{.Role}}{{else}}<span class="muted">unknown</span>{{end}}
      <span class="muted">·</span>
      LA {{.LogicalAddress}}
      {{if .PhysicalAddress}}<span class="muted">·</span> {{.PhysicalAddress}}{{end}}
      {{if .PowerStatus}}<span class="muted">·</span> {{.PowerStatus}}{{end}}
    </div>
    {{if not .IsGhost}}
    <div class="dev-actions">
      <button type="button" class="big"
              hx-post="/ui/action/power_on?addr={{.LogicalAddress}}"
              hx-target="#action-flash" hx-swap="innerHTML">On</button>
      <button type="button" class="big"
              hx-post="/ui/action/power_off?addr={{.LogicalAddress}}"
              hx-target="#action-flash" hx-swap="innerHTML">Standby</button>
      <button type="button" class="big"
              hx-post="/ui/action/set_source?addr={{.LogicalAddress}}"
              hx-target="#action-flash" hx-swap="innerHTML">Activate</button>
    </div>
    {{else}}
    <p class="muted" style="font-size:.7rem;margin-top:4px">
      Hidden by display switch. See <a href="/dev">/dev</a> blind-send to interact.
    </p>
    {{end}}
  </div>
  {{end}}
</div>
{{else}}
<p class="muted">No devices on bus yet. Quick controls above still work for the projector.</p>
{{end}}
{{end}}
