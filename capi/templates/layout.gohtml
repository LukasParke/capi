{{define "layout"}}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>capi remote</title>
  <link rel="stylesheet" href="/ui/static/style.css">
  <script src="/ui/static/htmx.min.js"></script>
</head>
<body class="remote">
  <header class="remote-head">
    <div>
      <h1>capi remote</h1>
      <span id="health-strip" class="muted"
            hx-get="/ui/fragment/health"
            hx-trigger="load, every 12s"
            hx-swap="innerHTML">…</span>
    </div>
    <nav class="remote-nav">
      <a href="/settings">Settings</a>
      <a href="/dev">Dev</a>
      <span class="badge off" style="font-size:.65rem">v {{.Version}}</span>
    </nav>
  </header>

  <div id="bus-banner" class="bus-banner-strip"
       hx-get="/ui/fragment/bus_banner"
       hx-trigger="load, every 8s, refresh from:body"
       hx-swap="innerHTML"></div>

  <!--
    Quick controls. These are always visible and depend ONLY on knowing the
    TV's logical address (0). They work even when no other devices have
    enumerated, so the projector can be powered on / HDMI-switched without
    the device list being populated.
  -->
  <section class="card remote-quick">
    {{template "quick_controls" .}}
  </section>

  <!-- Compact navigation pad. Targets the active source by default; the
       dropdown lets the user override. -->
  <section class="card remote-pad-card">
    {{template "remote_pad" .}}
  </section>

  <!-- Devices on the bus, simplified to one card per device. Only the
       essentials: name, role, power, and the three actions you actually
       want from a remote (On / Standby / Activate-as-source). -->
  <section class="card full">
    <div class="row-between">
      <h2 style="margin:0">Devices</h2>
      <button type="button" class="sm"
              hx-get="/ui/fragment/devices"
              hx-target="#devices-panel"
              hx-swap="innerHTML">Refresh</button>
    </div>
    <div id="devices-panel"
         hx-get="/ui/fragment/devices"
         hx-trigger="load, refresh from:body"
         hx-swap="innerHTML"></div>
  </section>

  <div id="action-flash" class="result" style="margin-top:12px"></div>
  <div id="toast" class="toast"></div>
</body>
</html>
{{end}}
