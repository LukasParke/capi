{{define "source_panel"}}
<h2>Active source</h2>
{{if .Ready}}
  {{if .QueryErr}}
  <p class="result err">{{.QueryErr}}</p>
  {{else}}
  <p style="margin-bottom:10px">Logical address <strong>{{.ActiveLA}}</strong> ({{.ActiveName}})</p>
  {{end}}
  <p style="font-size:.72rem;color:var(--muted)">Use <strong>Devices</strong> cards or the <strong>Source / HDMI</strong> card to switch source.</p>
{{else}}
<p style="color:var(--muted)">CEC not ready — cannot read active source.</p>
{{end}}
{{end}}
