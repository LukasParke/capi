{{define "volume_panel"}}
<h2>Volume <span style="font-size:.75rem;color:var(--muted);font-weight:normal;margin-left:8px">{{.AudioLine}}</span></h2>
<p style="font-size:.72rem;color:var(--muted);margin-bottom:8px">Default uses best-effort CEC (AVR/TV keys + libCEC). Choose a logical address if auto fails.</p>
<form id="vol-frm" class="btn-row" style="margin-top:8px;flex-wrap:wrap;gap:8px;align-items:center">
  <label style="display:flex;align-items:center;gap:6px">Target
    <select name="addr">{{range .VolOptions}}<option value="{{.Value}}">{{.Label}}</option>{{end}}</select>
  </label>
  <button type="button" hx-post="/ui/action/volume_up" hx-include="#vol-frm" hx-target="#action-flash" hx-swap="innerHTML">Vol +</button>
  <button type="button" hx-post="/ui/action/volume_down" hx-include="#vol-frm" hx-target="#action-flash" hx-swap="innerHTML">Vol −</button>
  <button type="button" hx-post="/ui/action/volume_mute" hx-include="#vol-frm" hx-target="#action-flash" hx-swap="innerHTML">Mute</button>
</form>
{{end}}
